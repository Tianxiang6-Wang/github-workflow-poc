# fusion-services
{{- range ( list
    "agents"
    "operations"
    "tasks_graphs"
    "plugins-updates"
    "executions"
    "events"
    "summary"
    "plugins"
    "execution-groups"
    "labels"
    "node-instances"
    "searches"
    "nodes"
    "version"
    "deployment-groups"
) }}
location /rest/v1/service-orchestration/{{ . }} {
      resolver kube-dns.kube-system.svc.cluster.local;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header Tenant "default_tenant";
      set $upstream http://fusion-entrypoint.{{$.Release.Namespace}}.svc.cluster.local:80/api/v3.1/{{ . }};
      proxy_pass $upstream;
      proxy_http_version 1.1;
      proxy_ssl_verify off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
}
{{- end }}

# Upgrade API routing
location /api/v2/upgrade {
      resolver kube-dns.kube-system.svc.cluster.local;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      set $upstream http://hzp-upgrade-svc.{{$.Release.Namespace}}.svc.cluster.local:80;
      proxy_pass $upstream;
      proxy_http_version 1.1;
      proxy_ssl_verify off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      keepalive_timeout 600s;
      proxy_connect_timeout 600s;
      proxy_buffering off;
}

# API gateway svc routing
{{- range ( list
    "/rest/v1"
    "/rest/v2"
) }}
location {{ . }} {
      resolver kube-dns.kube-system.svc.cluster.local;
      limit_req zone=api_gateway_rate_limit burst={{ $.Values.rateLimits.apiGateway.burst }} nodelay;
      limit_req_status 429;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      set $upstream http://hzp-api-gateway-svc.{{$.Release.Namespace}}.svc.cluster.local:80;
      proxy_pass $upstream;
      proxy_http_version 1.1;
      proxy_ssl_verify off;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      keepalive_timeout 600s;
      proxy_connect_timeout 600s;
      proxy_buffering off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
}
{{- end }}
