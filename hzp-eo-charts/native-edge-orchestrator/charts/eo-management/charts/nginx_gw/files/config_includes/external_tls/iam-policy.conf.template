{{- range ( list
    "/api/v2/iam-policy/permissions-tree"
    "/api/v2/iam-policy/current-user-permissions"
    "/api/v2/iam-policy/policies"
    "~ /api/v2/iam-policy/policies/.*"
) }}
location {{ . }} {
      resolver kube-dns.kube-system.svc.cluster.local;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      {{- $portalEnabled := and $.Values.global.dsp.enabled $.Values.global.dsp.portal.enabled }}
      set $upstream http://{{ ternary (printf "dsp-iam-policy-svc.%s" $.Values.global.dsp.portal.namespace) (printf "hzp-iam-policy-svc.%s" $.Release.Namespace) $portalEnabled }}.svc.cluster.local;
      proxy_pass $upstream;
      proxy_http_version 1.1;
      proxy_ssl_verify off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
}
{{- end }}
