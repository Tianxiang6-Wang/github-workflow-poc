{{- range $.Values.eoServicesMTLSRecovery }}
location /{{ .serviceName | lower }}/api/ {
      resolver kube-dns.kube-system.svc.cluster.local;
      proxy_set_header Host hzp-{{ .serviceName  | lower }}-svc.{{$.Release.Namespace}}.svc.cluster.local;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      set $upstream http://hzp-{{ .serviceName  | lower }}-svc.{{$.Release.Namespace}}.svc.cluster.local:80;
      rewrite ^/{{ .serviceName | lower }}/api/(.*) /api/$1 break;
      proxy_pass $upstream;
      proxy_http_version 1.1;
      proxy_ssl_verify off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
}
{{- end }}

{{- range ( list
  "/api/v1/rv"
  "/api/v1/owner"
  "/fdo/101/msg"
  "/catalog/api"
  "/oe-template-mgr/api"
  "/security/api"
  "/nats"
  "/metrics"
  "/repository"
  "/time/api"
  "/datacollection/api"
  "/certificate/api"
  "/recovery/api"
) }}
location {{ . }} {
      include /etc/nginx/ip-sources/ip-allowlist.txt;
      deny all;
}
{{- end }}
