location /api/v2/eoproxy/ {
      resolver kube-dns.kube-system.svc.cluster.local;
      proxy_set_header Host hzp-eoproxy-svc.{{$.Release.Namespace}}.svc.cluster.local;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      set $upstream http://hzp-eoproxy-svc.{{$.Release.Namespace}}.svc.cluster.local:8088;
      rewrite ^/api/v2/eoproxy/(.*) /$1 break;
      proxy_pass $upstream;
      proxy_http_version 1.1;
      proxy_ssl_verify off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
}
{{- if $.Values.global.ingress.exposeEOServices }}
location /eoproxy/api/ {
    resolver kube-dns.kube-system.svc.cluster.local;
    proxy_set_header Host hzp-eoproxy-svc.{{$.Release.Namespace}}.svc.cluster.local;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    set $upstream http://hzp-eoproxy-svc.{{$.Release.Namespace}}.svc.cluster.local:8080;
    rewrite ^/eoproxy/api/(.*) /api/$1 break;
    proxy_pass $upstream;
    proxy_http_version 1.1;
    proxy_ssl_verify off;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}
{{- end }}
