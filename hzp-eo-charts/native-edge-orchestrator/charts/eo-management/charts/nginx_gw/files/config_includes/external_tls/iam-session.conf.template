{{- range ( list
  "/api/v2/sessions"
  "/api/v3/sessions"
  "/api/v2/auth/logout"
  "/api/v2/auth/details"
  "/api/v2/auth/callback"
  "= /api/v3/auth/tokens"
  "= /api/v4/auth/tokens"
  "~ /api/v5/auth/tokens/.*"
) }}
location {{ . }} {
      resolver kube-dns.kube-system.svc.cluster.local;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      set $upstream http://{{- if $.Values.global.dsp.portal.namespace -}}{{ printf "dsp-iam-session-svc.%s" $.Values.global.dsp.portal.namespace }}{{- else -}}dsp-iam-session-svc.dapp{{- end -}}.svc.cluster.local;
      proxy_pass $upstream;
      proxy_http_version 1.1;
      proxy_ssl_verify off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
}
{{- end }}
