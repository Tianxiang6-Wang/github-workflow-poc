location ~ ^${PUBLIC_PATH}/(.*) {
    rewrite ^${PUBLIC_PATH}(/.*)$ /buckets${PUBLIC_PATH}$1 break;
    include "/etc/nginx/conf.d/service-proxy-settings";

    # Use Lua script for Basic Auth validation by including an external Lua file
    access_by_lua_file          "/etc/nginx/lua/basic_auth.lua";

    access_log                  off;

    # CIS 5.2.1
    client_max_body_size        ${CLIENT_MAX_BODY_SIZE};
    proxy_connect_timeout       ${PROXY_CONNECT_TIMEOUT};
    send_timeout                ${SEND_TIMEOUT};
    proxy_send_timeout          ${PROXY_SEND_TIMEOUT};
    proxy_read_timeout          ${PROXY_READ_TIMEOUT};
    client_body_timeout         ${CLIENT_BODY_TIMEOUT};
    keepalive_timeout           ${KEEPALIVE_TIMEOUT};
    uwsgi_read_timeout          ${UWSGI_READ_TIMEOUT};

    slice                      100m;
    proxy_cache                cache;
    proxy_cache_key            $request_uri$slice_range;
    proxy_set_header           Connection "";
    proxy_set_header           Range $slice_range;
    proxy_cache_valid          200 206 6m;
    proxy_cache_lock           on;
    proxy_cache_lock_timeout   10s;
    proxy_ignore_headers       Cache-Control Expires;
    proxy_pass                 http://fileserver;
    
    limit_except GET PUT DELETE POST {
        # block does not inherit the access limitations from above
        deny all;
    }

    autoindex on;
    autoindex_exact_size off;
    autoindex_format json;
}
