# TODO: replace location and upstream address if necessary
location ~ ^/rest/v1/offers(/.*)?$ {
    rewrite ^/rest/v1/offers(/.*)?$ /api/v1/catalog/offers$1 last;
}
location ~ ^/rest/v1/plugins(/.*)?$ {
    rewrite ^/rest/v1/plugins(/.*)?$ /api/v1/catalog/plugins$1 last;
}
{{- range ( list
    "~ /api/v1/catalog/.*"
) }}
location {{ . }} {
      resolver kube-dns.kube-system.svc.cluster.local;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Real-IP $remote_addr;
      set $upstream http://dsp-catalog-svc.{{$.Release.Namespace}}.svc.cluster.local:8080;
      proxy_pass $upstream;
      proxy_http_version 1.1;
      proxy_ssl_verify off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      include /etc/nginx/ip-sources/ip-allowlist.txt;
}
{{- end }}
