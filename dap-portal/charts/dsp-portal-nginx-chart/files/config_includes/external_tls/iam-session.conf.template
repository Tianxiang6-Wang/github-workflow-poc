# TODO: replace location and upstream address if necessary
{{- range ( list
  "/api/v2/sessions"
  "/api/v3/sessions"
  "/api/v2/auth/logout"
  "/api/v2/auth/details"
  "/api/v2/auth/callback"
  "= /api/v3/auth/tokens"
  "= /api/v4/auth/tokens"
  "/api/v5/auth/tokens"
  "/api/v2/auth/orgs/login"
  "/api/v2/auth/user-agreement"
  "/internal/api/v1/tokens"
) }}
location {{ . }} {
      resolver kube-dns.kube-system.svc.cluster.local;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      set $upstream http://dsp-iam-session-svc.{{$.Release.Namespace}}.svc.cluster.local:80;
      proxy_pass $upstream;
      proxy_http_version 1.1;
      proxy_ssl_verify off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      include /etc/nginx/ip-sources/ip-allowlist.txt;
}
{{- end }}
