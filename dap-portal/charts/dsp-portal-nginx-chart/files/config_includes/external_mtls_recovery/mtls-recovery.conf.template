# FIXME: this is just a placeholder before real mtls recovery location will be defined
location /placeholder {
      resolver kube-dns.kube-system.svc.cluster.local;
      proxy_set_header Host placeholder.{{$.Release.Namespace}}.svc.cluster.local;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      set $upstream http://placeholder.{{$.Release.Namespace}}.svc.cluster.local:80;
      proxy_pass $upstream;
      proxy_http_version 1.1;
      proxy_ssl_verify off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      include /etc/nginx/ip-sources/ip-allowlist.txt;
}
